class Solution(object):
    def romanToInt(self, s):
        """
        :type s: str
        :rtype: int
        """ 
        numbers = {"I" : 1, "V" : 5,"X" : 10, "L" : 50, "C" : 100, "D" : 500, "M" : 1000}
        self.q = list(s)
        self.count = 0
        for i in range (len(self.q)-1):
            if numbers[self.q[i]] < numbers[self.q[i+1]]:
                self.count -=numbers[self.q[i]]
            else:
                self.count +=numbers[self.q[i]]
        self.count +=numbers[self.q[len(self.q)-1]]
        return self.count
